# PostgreSQL 연결 문자열
# 로컬:     postgres://postgres:postgres@localhost:5432/shinhon
# Neon:     postgres://user:pass@ep-xxx.neon.tech/shinhon?sslmode=require
# Supabase: postgres://postgres.xxx:pass@aws-x-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 국토교통부 수집기 옵션
MOLIT_REQUEST_DELAY_MS=1500
MOLIT_REQUEST_TIMEOUT_MS=120000
MOLIT_RETRY_COUNT=3
