# PostgreSQL 연결 문자열
# 로컬:     postgres://postgres:postgres@localhost:5432/shinhon
# Neon:     postgres://user:pass@ep-xxx.neon.tech/shinhon?sslmode=require
# Supabase: postgres://postgres.xxx:pass@aws-x-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 국토교통부 수집기 옵션
MOLIT_REQUEST_DELAY_MS=1500
MOLIT_REQUEST_TIMEOUT_MS=120000
MOLIT_RETRY_COUNT=3

# ── 수익화(배포 후 채우면 자동 활성. 비워두면 관련 UI 미노출) ──
# 구글 애드센스 게시자 ID — 승인 후 발급. 예: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=
# 애드센스 우측 사이드바 광고 슬롯 ID — 광고 단위 생성 시 발급. 예: 1234567890
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# 카카오톡 채널 URL — '광고 없이 이용' 구독 문의. 예: https://pf.kakao.com/_xxxxx
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
