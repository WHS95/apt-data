{
  "name": "shinhon-realty",
  "version": "0.1.0",
  "private": true,
  "description": "신혼부부 첫 집 구하기 — 국토교통부 실거래가 데이터 서비스",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/infrastructure/persistence/seed.ts",
    "수집:전체": "tsx --env-file=.env src/infrastructure/molit/수집_실행.ts --mode full",
    "수집:증분": "tsx --env-file=.env src/infrastructure/molit/수집_실행.ts --mode incremental",
    "수집:2년": "tsx --env-file=.env src/infrastructure/molit/수집_실행.ts --mode full --years 2",
    "스케줄러": "tsx --env-file=.env src/infrastructure/molit/스케줄러_실행.ts",
    "카드:데이터": "python3 src/studio/emit_data.py",
    "카드:빌드": "node src/studio/build.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.4",
    "iconv-lite": "^0.6.3",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0-beta.7",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
